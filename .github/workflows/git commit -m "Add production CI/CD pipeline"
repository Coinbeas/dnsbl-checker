name: DNSBL Checker CI/CD

on:
  push:
    branches:
      - main
  pull_request:
    branches:
      - main

permissions:
  contents: read

jobs:
  lint:
    name: PHP Lint
    runs-on: ubuntu-latest

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Setup PHP
        uses: shivammathur/setup-php@v2
        with:
          php-version: "8.2"

      - name: Validate PHP syntax
        run: |
          find . \
            -name "*.php" \
            -type f \
            ! -path "./vendor/*" \
            -exec php -l {} \;

  frontend:
    name: Validate Frontend
    runs-on: ubuntu-latest

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: "20"

      - name: Validate JavaScript
        run: node --check app.js

      - name: Check frontend files
        run: |
          test -f index.html
          test -f style.css
          test -f app.js
          echo "Frontend files validated."

  structure:
    name: Project Structure
    runs-on: ubuntu-latest

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Verify project
        run: |
          test -f index.html
          test -f style.css
          test -f app.js
          test -f check.php
          echo "Project structure OK."

  security:
    name: Security Checks
    runs-on: ubuntu-latest

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Check sensitive files
        run: |
          if find . -type f \( \
            -name ".env" \
            -o -name ".env.local" \
            -o -name "*.key" \
            -o -name "*.pem" \
          \) | grep -q .; then
            echo "Sensitive files detected."
            exit 1
          else
            echo "No sensitive files detected."
          fi

      - name: Setup PHP
        uses: shivammathur/setup-php@v2
        with:
          php-version: "8.2"

      - name: PHP syntax scan
        run: |
          find . \
            -name "*.php" \
            -type f \
            ! -path "./vendor/*" \
            -exec php -l {} \;

  build:
    name: Build
    runs-on: ubuntu-latest

    needs:
      - lint
      - frontend
      - structure
      - security

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Prepare build
        run: |
          mkdir -p build/dnsbl-checker

          cp index.html build/dnsbl-checker/
          cp style.css build/dnsbl-checker/
          cp app.js build/dnsbl-checker/
          cp check.php build/dnsbl-checker/

          if [ -d "src" ]; then
            cp -r src build/dnsbl-checker/
          fi

          if [ -f "README.md" ]; then
            cp README.md build/dnsbl-checker/
          fi

      - name: Create archive
        run: |
          tar -czf build/dnsbl-checker.tar.gz \
            -C build dnsbl-checker

      - name: Upload build artifact
        uses: actions/upload-artifact@v4
        with:
          name: dnsbl-checker-build
          path: build/dnsbl-checker.tar.gz
